        function runCalculator() {
            const dist = parseFloat(document.getElementById('calc-distance').value) || 0;
            const timeVal = document.getElementById('calc-time').value;
            const sec = parseTimeToSeconds(timeVal);

            const pace = calculatePace(dist, sec);
            document.getElementById('calc-result-pace').textContent = pace;

            let speed = sec > 0 && dist > 0 ? (dist / (sec / 3600)).toFixed(2) : '0';
            document.getElementById('calc-result-speed').textContent = `${speed} km/h`;

            const secPerKm = dist > 0 ? sec / dist : 0;
            const targets = [
                { name: '1 km', d: 1 },
                { name: '2.6 km TT', d: 2.6 },
                { name: '5 km', d: 5 },
                { name: '10 km', d: 10 },
                { name: 'ハーフマラソン', d: 21.0975 }
            ];

            const tbody = document.getElementById('estimation-table-body');
            tbody.innerHTML = '';
            targets.forEach(t => {
                const estSec = Math.round(secPerKm * t.d);
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="py-2 px-3 font-medium text-slate-700">${t.name}</td>
                    <td class="py-2 px-3 font-bold text-cyan-700">${secPerKm > 0 ? formatSecondsToTimeStr(estSec) : '-'}</td>
                `;
                tbody.appendChild(tr);
            });
        }

