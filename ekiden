<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Track & Field Team Hub Pro | 陸上部・ランニングチーム管理システム</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter & Noto Sans JP -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans JP', 'Inter', sans-serif;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- ヘッダー -->
    <header class="bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col md:flex-row justify-between items-center gap-3">
            <div class="flex items-center space-x-3">
                <div class="bg-white/15 p-2 rounded-xl backdrop-blur-md">
                    <i class="fa-solid fa-person-running text-2xl text-amber-300"></i>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-black tracking-tight flex items-center gap-2">
                        Track & Field Hub <span class="text-xs bg-amber-400 text-slate-900 font-bold px-2 py-0.5 rounded-full">PRO</span>
                    </h1>
                    <p class="text-[11px] text-emerald-100">陸上部・ランニングチーム総合記録 & インターバル分析アプリ</p>
                </div>
            </div>
            
            <!-- ナビゲーションタブボタン (デスクトップ) -->
            <nav class="hidden lg:flex items-center space-x-1 bg-black/10 p-1.5 rounded-xl backdrop-blur-sm">
                <button onclick="switchTab('records')" id="nav-records" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-bold transition-all bg-white text-emerald-700 shadow-sm">
                    <i class="fa-solid fa-clipboard-list mr-1"></i> 練習記録
                </button>
                <button onclick="switchTab('batch')" id="nav-batch" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-bold transition-all text-white hover:bg-white/10">
                    <i class="fa-solid fa-users-rectangle mr-1"></i> 全体一括入力
                </button>
                <button onclick="switchTab('condition')" id="nav-condition" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-bold transition-all text-white hover:bg-white/10 relative">
                    <i class="fa-solid fa-heart-pulse mr-1"></i> コンディション
                    <span id="alert-badge-top" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] px-1.5 py-0.5 rounded-full hidden">0</span>
                </button>
                <button onclick="switchTab('ranking')" id="nav-ranking" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-bold transition-all text-white hover:bg-white/10">
                    <i class="fa-solid fa-trophy mr-1"></i> 2.6km TT
                </button>
                <button onclick="switchTab('calculator')" id="nav-calculator" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-bold transition-all text-white hover:bg-white/10">
                    <i class="fa-solid fa-calculator mr-1"></i> ペース計算
                </button>
                <button onclick="switchTab('members')" id="nav-members" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-bold transition-all text-white hover:bg-white/10">
                    <i class="fa-solid fa-user-group mr-1"></i> メンバー
                </button>
            </nav>

            <!-- 管理者ログイン / ステータス -->
            <div class="flex items-center space-x-2">
                <div id="admin-status-badge" class="hidden items-center bg-amber-400 text-slate-900 text-xs px-2.5 py-1 rounded-full font-bold shadow">
                    <i class="fa-solid fa-shield-halved mr-1"></i> 管理者
                </div>
                <button onclick="openAdminModal()" id="admin-toggle-btn" class="bg-white/20 hover:bg-white/30 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5">
                    <i class="fa-solid fa-lock" id="admin-btn-icon"></i> <span id="admin-btn-text">管理者ログイン</span>
                </button>
            </div>
        </div>
        
        <!-- モバイル用ナビゲーションタブバー -->
        <div class="lg:hidden flex overflow-x-auto px-3 py-2 bg-emerald-900/30 gap-1 border-t border-white/10 scrollbar-none">
            <button onclick="switchTab('records')" id="mob-nav-records" class="mob-tab-btn whitespace-nowrap px-3 py-1 rounded-lg text-xs font-bold bg-white text-emerald-800">
                <i class="fa-solid fa-clipboard-list mr-1"></i> 練習記録
            </button>
            <button onclick="switchTab('batch')" id="mob-nav-batch" class="mob-tab-btn whitespace-nowrap px-3 py-1 rounded-lg text-xs font-bold text-white hover:bg-white/10">
                <i class="fa-solid fa-users-rectangle mr-1"></i> 一括入力
            </button>
            <button onclick="switchTab('condition')" id="mob-nav-condition" class="mob-tab-btn whitespace-nowrap px-3 py-1 rounded-lg text-xs font-bold text-white hover:bg-white/10 relative">
                <i class="fa-solid fa-heart-pulse mr-1"></i> コンディション
                <span id="alert-badge-mob" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[9px] px-1 py-0.2 rounded-full hidden">0</span>
            </button>
            <button onclick="switchTab('ranking')" id="mob-nav-ranking" class="mob-tab-btn whitespace-nowrap px-3 py-1 rounded-lg text-xs font-bold text-white hover:bg-white/10">
                <i class="fa-solid fa-trophy mr-1"></i> 2.6km TT
            </button>
            <button onclick="switchTab('calculator')" id="mob-nav-calculator" class="mob-tab-btn whitespace-nowrap px-3 py-1 rounded-lg text-xs font-bold text-white hover:bg-white/10">
                <i class="fa-solid fa-calculator mr-1"></i> 計算機
            </button>
            <button onclick="switchTab('members')" id="mob-nav-members" class="mob-tab-btn whitespace-nowrap px-3 py-1 rounded-lg text-xs font-bold text-white hover:bg-white/10">
                <i class="fa-solid fa-user-group mr-1"></i> メンバー
            </button>
        </div>
    </header>

    <!-- メインコンテンツ領域 -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-5 space-y-5">

        <!-- チーム統計ダッシュボード -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">総練習記録数</p>
                    <h3 class="text-2xl font-black text-slate-800 mt-0.5" id="stat-total-records">0 <span class="text-xs font-normal text-slate-500">件</span></h3>
                </div>
                <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-lg">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">チーム累計距離</p>
                    <h3 class="text-2xl font-black text-slate-800 mt-0.5" id="stat-total-distance">0.0 <span class="text-xs font-normal text-slate-500">km</span></h3>
                </div>
                <div class="w-10 h-10 bg-teal-50 text-teal-600 rounded-xl flex items-center justify-center text-lg">
                    <i class="fa-solid fa-route"></i>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">登録メンバー数</p>
                    <h3 class="text-2xl font-black text-slate-800 mt-0.5" id="stat-total-members">0 <span class="text-xs font-normal text-slate-500">名</span></h3>
                </div>
                <div class="w-10 h-10 bg-cyan-50 text-cyan-600 rounded-xl flex items-center justify-center text-lg">
                    <i class="fa-solid fa-users"></i>
                </div>
            </div>
        </div>

        <!-- 不調・けがアラート通知バナー -->
        <div id="alert-banner" class="hidden bg-rose-50 border-l-4 border-rose-500 p-3.5 rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="text-rose-500 text-lg">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <h4 class="font-bold text-rose-800 text-xs sm:text-sm">コンディション注意アラート</h4>
                    <p class="text-xs text-rose-700" id="alert-banner-text">不調またはけがを報告しているメンバーがいます。</p>
                </div>
            </div>
            <button onclick="switchTab('condition')" class="text-xs font-bold text-rose-700 bg-rose-100 hover:bg-rose-200 px-3 py-1 rounded-lg transition-all whitespace-nowrap">
                確認
            </button>
        </div>

        <!-- ================= TAB 1: 練習記録・入力 ================= -->
        <div id="tab-content-records" class="tab-content space-y-5">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                
                <!-- 記録投稿フォーム (6カラム) -->
                <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 lg:col-span-6 space-y-4">
                    <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                        <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-pen-to-square text-emerald-600"></i> 個別練習記録の登録
                        </h2>
                        <!-- 種別切り替えタブ -->
                        <div class="inline-flex bg-slate-100 p-1 rounded-xl text-xs font-bold">
                            <button type="button" id="type-btn-normal" onclick="setPracticeType('normal')" class="px-3 py-1 rounded-lg transition-all bg-white text-emerald-700 shadow-xs">通常走・距離走</button>
                            <button type="button" id="type-btn-interval" onclick="setPracticeType('interval')" class="px-3 py-1 rounded-lg transition-all text-slate-600 hover:text-slate-900">インターバル</button>
                        </div>
                    </div>

                    <form id="record-form" onsubmit="handleRecordSubmit(event)" class="space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-600 mb-1">日付</label>
                                <input type="date" id="rec-date" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-600 mb-1">名前</label>
                                <input type="text" id="rec-name" list="member-datalist" placeholder="選択または直接入力" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                <datalist id="member-datalist"></datalist>
                            </div>
                        </div>

                        <!-- ワンタップ名前タグ -->
                        <div>
                            <span class="text-[11px] font-semibold text-slate-400 block mb-1">クイック名前選択:</span>
                            <div id="quick-tag-container" class="flex flex-wrap gap-1 max-h-20 overflow-y-auto">
                                <span class="text-xs text-slate-400 italic">※メンバータブで名前を追加するとここに表示されます</span>
                            </div>
                        </div>

                        <!-- メニュー＆クイックボタン -->
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1">練習メニュー名</label>
                            <input type="text" id="rec-menu" placeholder="例: 10kmジョグ, 2.6km TT, 400m×10本" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 mb-1.5">
                            <div class="flex flex-wrap gap-1">
                                <button type="button" onclick="setQuickMenu('2.6km タイムトライアル', 2.6, 'normal')" class="text-[11px] bg-amber-50 hover:bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded-lg border border-amber-200">2.6km TT</button>
                                <button type="button" onclick="setQuickMenu('5km ペース走', 5.0, 'normal')" class="text-[11px] bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-0.5 rounded-lg">5km ペース走</button>
                                <button type="button" onclick="setQuickMenu('10km ジョグ', 10.0, 'normal')" class="text-[11px] bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-0.5 rounded-lg">10km ジョグ</button>
                                <button type="button" onclick="setQuickMenu('1000m×5 インターバル', 1.0, 'interval', 5)" class="text-[11px] bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-lg border border-emerald-200">1000m×5本</button>
                                <button type="button" onclick="setQuickMenu('400m×10 インターバル', 0.4, 'interval', 10)" class="text-[11px] bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-lg border border-emerald-200">400m×10本</button>
                            </div>
                        </div>

                        <!-- 通常走行モード用フィールド -->
                        <div id="section-normal-input" class="space-y-3">
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1">走行距離 (km)</label>
                                    <input type="number" step="0.01" id="rec-distance" placeholder="10.0" oninput="calculateNormalPacePreview()" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1">タイム (数字入力可: 923→9'23")</label>
                                    <input type="text" id="rec-time" placeholder="4230 (42'30&quot;)" onblur="formatSmartTimeInput(this); calculateNormalPacePreview()" oninput="calculateNormalPacePreview()" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                </div>
                            </div>
                        </div>

                        <!-- インターバル練習モード用フィールド -->
                        <div id="section-interval-input" class="hidden space-y-3 bg-emerald-50/50 p-3.5 rounded-2xl border border-emerald-100">
                            <div class="flex justify-between items-center">
                                <span class="text-xs font-bold text-emerald-800"><i class="fa-solid fa-list-ol mr-1"></i> インターバル本数 & タイム設定</span>
                                <div class="flex gap-1">
                                    <button type="button" onclick="changeIntervalCount(-1)" class="w-7 h-7 bg-white hover:bg-emerald-100 text-emerald-800 font-bold rounded-lg border border-emerald-200 text-xs flex items-center justify-center">-</button>
                                    <button type="button" onclick="changeIntervalCount(1)" class="w-7 h-7 bg-white hover:bg-emerald-100 text-emerald-800 font-bold rounded-lg border border-emerald-200 text-xs flex items-center justify-center">+</button>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-600 mb-1">1本あたりの距離 (km)</label>
                                    <input type="number" step="0.01" id="int-single-dist" value="0.4" oninput="recalcIntervalStats()" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-600 mb-1">本数</label>
                                    <input type="number" id="int-count" value="5" min="1" max="20" onchange="renderIntervalRows()" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                </div>
                            </div>

                            <!-- 各本のタイム入力グリッド -->
                            <div id="interval-times-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2 max-h-48 overflow-y-auto p-1">
                                <!-- 動的生成 -->
                            </div>

                            <!-- インターバル自動統計プレビュー -->
                            <div class="bg-white p-2.5 rounded-xl border border-emerald-200 grid grid-cols-3 gap-2 text-center text-xs">
                                <div>
                                    <div class="text-[10px] text-slate-400 font-semibold">平均タイム</div>
                                    <div class="font-extrabold text-emerald-700" id="int-stat-avg">0'00"</div>
                                </div>
                                <div>
                                    <div class="text-[10px] text-slate-400 font-semibold">合計距離 / タイム</div>
                                    <div class="font-bold text-slate-800" id="int-stat-total">0.0km / 0'00"</div>
                                </div>
                                <div>
                                    <div class="text-[10px] text-slate-400 font-semibold">平均ペース</div>
                                    <div class="font-bold text-teal-700" id="int-stat-pace">-</div>
                                </div>
                            </div>
                        </div>

                        <!-- 共通ペース算出プレビュー -->
                        <div id="normal-pace-box" class="bg-emerald-50 border border-emerald-100 rounded-xl p-2.5 flex items-center justify-between text-xs text-emerald-800">
                            <span class="font-bold"><i class="fa-solid fa-gauge-high mr-1"></i> 平均ペース自動算出:</span>
                            <span id="pace-preview" class="font-black text-sm text-emerald-700">-</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-600 mb-1">コンディション</label>
                                <select id="rec-condition" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                    <option value="良好">$D83D$DFE2 良好（絶好調）</option>
                                    <option value="普通">$D83D$DFE1 普通（通常運転）</option>
                                    <option value="不調">$D83D$DFE0 不調（疲れ・倦怠感）</option>
                                    <option value="けが">$D83D$DD34 けが（痛み・故障）</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-600 mb-1">感想メモタグ (タップで挿入)</label>
                                <div class="flex flex-wrap gap-1">
                                    <button type="button" onclick="appendCommentTag('感覚良し！')" class="text-[10px] bg-slate-100 hover:bg-slate-200 px-2 py-0.5 rounded text-slate-700">+感覚良し</button>
                                    <button type="button" onclick="appendCommentTag('ラストスパート成功')" class="text-[10px] bg-slate-100 hover:bg-slate-200 px-2 py-0.5 rounded text-slate-700">+ラスト成功</button>
                                    <button type="button" onclick="appendCommentTag('後半失速')" class="text-[10px] bg-slate-100 hover:bg-slate-200 px-2 py-0.5 rounded text-slate-700">+後半失速</button>
                                    <button type="button" onclick="appendCommentTag('足に違和感あり')" class="text-[10px] bg-rose-50 hover:bg-rose-100 text-rose-700 px-2 py-0.5 rounded border border-rose-200">+足に違和感</button>
                                </div>
                            </div>
                        </div>

                        <div>
                            <textarea id="rec-comment" rows="2" placeholder="今日の練習の感想、反省、メモ..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
                        </div>

                        <button type="submit" class="w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-black py-3 rounded-xl shadow-md transition-all text-sm flex items-center justify-center gap-2">
                            <i class="fa-solid fa-plus"></i> 記録を保存する
                        </button>
                    </form>
                </div>

                <!-- 練習記録一覧 (6カラム) -->
                <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 lg:col-span-6 flex flex-col space-y-3">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-2 border-b border-slate-100">
                        <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-list-ul text-emerald-600"></i> タイムライン & 詳細
                        </h2>
                        <!-- フィルター -->
                        <div class="flex items-center gap-2 w-full sm:w-auto">
                            <input type="text" id="record-search" oninput="renderRecordsList()" placeholder="検索..." class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1 text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 w-full sm:w-36">
                            <select id="record-filter-cond" onchange="renderRecordsList()" class="bg-slate-50 border border-slate-200 rounded-xl px-2 py-1 text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                <option value="">すべて</option>
                                <option value="良好">良好</option>
                                <option value="普通">普通</option>
                                <option value="不調">不調</option>
                                <option value="けが">けが</option>
                            </select>
                        </div>
                    </div>
                    
                    <div id="records-list-container" class="space-y-3 overflow-y-auto max-h-[620px] pr-1">
                        <!-- 動的挿入 -->
                    </div>
                </div>

            </div>
        </div>

        <!-- ================= TAB 2: 全体練習一括入力 ================= -->
        <div id="tab-content-batch" class="tab-content hidden space-y-5">
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
