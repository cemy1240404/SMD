    <script>
        // 完全クリーンな初期状態（サンプルデータなし）
        let state = {
            members: JSON.parse(localStorage.getItem('tf_members')) || [],
            records: JSON.parse(localStorage.getItem('tf_records')) || [],
            isAdmin: JSON.parse(localStorage.getItem('tf_isAdmin')) || false,
            currentTab: 'records',
            practiceType: 'normal',
            batchType: 'normal'
        };

        window.onload = function() {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('rec-date').value = today;
            document.getElementById('batch-date').value = today;

            renderIntervalRows();
            syncStorage();
            updateUI();
        };

        function saveToStorage() {
            localStorage.setItem('tf_members', JSON.stringify(state.members));
            localStorage.setItem('tf_records', JSON.stringify(state.records));
            localStorage.setItem('tf_isAdmin', JSON.stringify(state.isAdmin));
        }

        function syncStorage() {
            saveToStorage();
        }

        function updateUI() {
            renderStatistics();
            renderAlertBanner();
            renderRecordsList();
            renderQuickTags();
            renderMemberDatalist();
            renderBatchTable();
            renderConditionCards();
            renderRankingTable();
            renderMembersGrid();
            runCalculator();
            updateAdminUIState();
        }

        // 全データのクリア初期化
        function clearAllData() {
            if (confirm("【警告】すべての練習記録およびメンバー一覧を完全に削除して初期化しますか？この操作は取り消せません。")) {
                state.members = [];
                state.records = [];
                syncStorage();
                updateUI();
                closeAdminModal();
                showToast("全データを消去し、アプリを初期化しました。", "success");
            }
        }

        function formatSmartTimeInput(inputEl) {
            let val = inputEl.value.trim();
            if (!val) return;

            val = val.replace(/["'h:]/g, '');
            if (!/^\d+$/.test(val)) return;

            let num = parseInt(val, 10);
            let result = "";

            if (val.length <= 2) {
                if (num >= 60) {
                    let m = Math.floor(num / 60);
                    let s = num % 60;
                    result = `${m}'${s < 10 ? '0' : ''}${s}"`;
                } else {
                    result = `0'${num < 10 ? '0' : ''}${num}"`;
                }
            } else if (val.length === 3) {
                let m = parseInt(val.substring(0, 1), 10);
                let s = parseInt(val.substring(1, 3), 10);
                if (s >= 60) { m += Math.floor(s / 60); s = s % 60; }
                result = `${m}'${s < 10 ? '0' : ''}${s}"`;
            } else if (val.length === 4) {
                let m = parseInt(val.substring(0, 2), 10);
                let s = parseInt(val.substring(2, 4), 10);
                if (s >= 60) { m += Math.floor(s / 60); s = s % 60; }
                result = `${m}'${s < 10 ? '0' : ''}${s}"`;
            } else if (val.length >= 5) {
                let h = parseInt(val.substring(0, val.length - 4), 10);
                let m = parseInt(val.substring(val.length - 4, val.length - 2), 10);
                let s = parseInt(val.substring(val.length - 2), 10);
                result = `${h}h${m < 10 ? '0' : ''}${m}'${s < 10 ? '0' : ''}${s}"`;
            }

            inputEl.value = result;
        }

        function parseTimeToSeconds(timeStr) {
            if (!timeStr) return 0;
            let str = timeStr.trim();
            
            let hours = 0;
            if (str.includes('h')) {
                let hParts = str.split('h');
                hours = parseInt(hParts[0], 10) || 0;
                str = hParts[1] || '';
            }

            let clean = str.replace(/["']/g, ':').replace(/:$/, '');
            let parts = clean.split(':');
            
            let mins = 0, secs = 0;
            if (parts.length === 2) {
                mins = parseInt(parts[0], 10) || 0;
                secs = parseInt(parts[1], 10) || 0;
            } else if (parts.length === 1) {
                secs = parseInt(parts[0], 10) || 0;
            }

            return hours * 3600 + mins * 60 + secs;
        }

        function formatSecondsToTimeStr(totalSec) {
            if (!totalSec || isNaN(totalSec) || totalSec <= 0) return "0'00\"";
            
            let h = Math.floor(totalSec / 3600);
            let rem = totalSec % 3600;
            let m = Math.floor(rem / 60);
            let s = Math.round(rem % 60);

            if (h > 0) {
                return `${h}h${m < 10 ? '0' : ''}${m}'${s < 10 ? '0' : ''}${s}"`;
            }
            return `${m}'${s < 10 ? '0' : ''}${s}"`;
        }

        function calculatePace(distanceKm, timeSec) {
            if (!distanceKm || distanceKm <= 0 || !timeSec || timeSec <= 0) return "-";
            let secPerKm = timeSec / distanceKm;
            let m = Math.floor(secPerKm / 60);
            let s = Math.round(secPerKm % 60);
            return `${m}'${s < 10 ? '0' : ''}${s}"/km`;
        }

        function setPracticeType(type) {
            state.practiceType = type;
            const btnNormal = document.getElementById('type-btn-normal');
            const btnInterval = document.getElementById('type-btn-interval');
            const secNormal = document.getElementById('section-normal-input');
            const secInterval = document.getElementById('section-interval-input');
            const paceBox = document.getElementById('normal-pace-box');

            if (type === 'normal') {
                btnNormal.className = "px-3 py-1 rounded-lg transition-all bg-white text-emerald-700 shadow-xs";
                btnInterval.className = "px-3 py-1 rounded-lg transition-all text-slate-600 hover:text-slate-900";
                secNormal.classList.remove('hidden');
                secInterval.classList.add('hidden');
                paceBox.classList.remove('hidden');
            } else {
                btnInterval.className = "px-3 py-1 rounded-lg transition-all bg-white text-emerald-700 shadow-xs";
                btnNormal.className = "px-3 py-1 rounded-lg transition-all text-slate-600 hover:text-slate-900";
                secNormal.classList.add('hidden');
                secInterval.classList.remove('hidden');
                paceBox.classList.add('hidden');
                recalcIntervalStats();
            }
        }

        function renderIntervalRows() {
            const count = parseInt(document.getElementById('int-count').value, 10) || 5;
            const container = document.getElementById('interval-times-grid');
            
            const existingVals = [];
            container.querySelectorAll('input').forEach(i => existingVals.push(i.value));

            container.innerHTML = '';
            for (let i = 0; i < count; i++) {
                const val = existingVals[i] || '';
                const div = document.createElement('div');
                div.className = 'flex items-center gap-1';
                div.innerHTML = `
                    <span class="text-[10px] font-bold text-slate-400 w-5">${i + 1}.</span>
                    <input type="text" placeholder="例: 70" value="${val}" onblur="formatSmartTimeInput(this); recalcIntervalStats()" oninput="recalcIntervalStats()" class="int-time-input w-full bg-white border border-slate-200 rounded-lg px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500">
                `;
                container.appendChild(div);
            }
            recalcIntervalStats();
        }

        function changeIntervalCount(delta) {
            const el = document.getElementById('int-count');
            let current = parseInt(el.value, 10) || 5;
            let updated = Math.max(1, Math.min(20, current + delta));
            el.value = updated;
            renderIntervalRows();
        }

        function recalcIntervalStats() {
            const singleDist = parseFloat(document.getElementById('int-single-dist').value) || 0;
            const timeInputs = document.querySelectorAll('.int-time-input');
            
            let totalSec = 0;
            let validCount = 0;

            timeInputs.forEach(input => {
                let sec = parseTimeToSeconds(input.value);
                if (sec > 0) {
                    totalSec += sec;
                    validCount++;
                }
            });

            const avgSec = validCount > 0 ? totalSec / validCount : 0;
            const totalDist = singleDist * validCount;
            const pace = calculatePace(totalDist, totalSec);

            document.getElementById('int-stat-avg').textContent = formatSecondsToTimeStr(avgSec);
            document.getElementById('int-stat-total').textContent = `${totalDist.toFixed(2)}km / ${formatSecondsToTimeStr(totalSec)}`;
            document.getElementById('int-stat-pace').textContent = pace;
        }

        function calculateNormalPacePreview() {
            const dist = parseFloat(document.getElementById('rec-distance').value);
            const timeVal = document.getElementById('rec-time').value;
            const sec = parseTimeToSeconds(timeVal);
            document.getElementById('pace-preview').textContent = calculatePace(dist, sec);
        }

        function setQuickMenu(menuName, defaultDist, type, defaultCount = 5) {
            document.getElementById('rec-menu').value = menuName;
            setPracticeType(type);
            if (type === 'normal') {
                document.getElementById('rec-distance').value = defaultDist;
                calculateNormalPacePreview();
            } else {
                document.getElementById('int-single-dist').value = defaultDist;
                document.getElementById('int-count').value = defaultCount;
                renderIntervalRows();
            }
        }

        function appendCommentTag(tagText) {
            const textarea = document.getElementById('rec-comment');
            if (textarea.value) {
                textarea.value += ' ' + tagText;
            } else {
                textarea.value = tagText;
            }
        }

        // RECORD FORM SUBMISSION
        function handleRecordSubmit(e) {
            e.preventDefault();
            const date = document.getElementById('rec-date').value;
            const name = document.getElementById('rec-name').value.trim();
            const menu = document.getElementById('rec-menu').value.trim();
            const condition = document.getElementById('rec-condition').value;
            const comment = document.getElementById('rec-comment').value.trim();

            if (!state.members.includes(name)) {
                state.members.push(name);
            }

            let newRecord = {
                id: 'rec_' + Date.now(),
                date,
                name,
                menu,
                type: state.practiceType,
                condition,
                comment
            };

            if (state.practiceType === 'normal') {
                const distance = parseFloat(document.getElementById('rec-distance').value) || 0;
                const timeVal = document.getElementById('rec-time').value;
                const timeSec = parseTimeToSeconds(timeVal);
                
                newRecord.distance = distance;
                newRecord.timeSec = timeSec;
                newRecord.timeStr = formatSecondsToTimeStr(timeSec);
                newRecord.paceStr = calculatePace(distance, timeSec);
            } else {
                const singleDist = parseFloat(document.getElementById('int-single-dist').value) || 0;
                const inputs = document.querySelectorAll('.int-time-input');
                let intervalTimes = [];
                let intervalSecs = [];
                let totalSec = 0;

                inputs.forEach(inp => {
                    let sec = parseTimeToSeconds(inp.value);
                    if (sec > 0) {
                        intervalSecs.push(sec);
                        intervalTimes.push(formatSecondsToTimeStr(sec));
                        totalSec += sec;
                    }
                });

                const totalDist = singleDist * intervalSecs.length;
                newRecord.singleDist = singleDist;
                newRecord.intervalTimes = intervalTimes;
                newRecord.intervalSecs = intervalSecs;
                newRecord.distance = totalDist;
                newRecord.timeSec = totalSec;
                newRecord.timeStr = formatSecondsToTimeStr(totalSec);
                newRecord.paceStr = calculatePace(totalDist, totalSec);
            }

            state.records.unshift(newRecord);
            syncStorage();
            updateUI();

            showToast('練習記録を登録しました！', 'success');
        }

