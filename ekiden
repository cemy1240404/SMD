        function updateBatchRowPace(idx) {
            const dist = parseFloat(document.getElementById('batch-distance').value) || 0;
            const timeVal = document.getElementById(`b-time-${idx}`).value;
            const sec = parseTimeToSeconds(timeVal);
            document.getElementById(`b-res-${idx}`).textContent = calculatePace(dist, sec);
        }

        function updateBatchRowIntervalPace(idx) {
            const singleDist = parseFloat(document.getElementById('batch-distance').value) || 0;
            const val = document.getElementById(`b-int-times-${idx}`).value.trim();
            if (!val) {
                document.getElementById(`b-res-${idx}`).textContent = '-';
                return;
            }

            const parts = val.split(/\s+/);
            let totalSec = 0;
            let count = 0;

            parts.forEach(p => {
                let s = parseTimeToSeconds(p);
                if (s > 0) {
                    totalSec += s;
                    count++;
                }
            });

            const totalDist = singleDist * count;
            const pace = calculatePace(totalDist, totalSec);
            document.getElementById(`b-res-${idx}`).textContent = `${count}本 (${formatSecondsToTimeStr(totalSec)}) / ${pace}`;
        }

        function handleBatchSubmit() {
            const date = document.getElementById('batch-date').value;
            const menu = document.getElementById('batch-menu').value.trim();
            const distanceInput = parseFloat(document.getElementById('batch-distance').value) || 0;

            if (!date || !menu || distanceInput <= 0) {
                showToast('日付、メニュー名、有効な距離を設定してください。', 'error');
                return;
            }

            let count = 0;
            state.members.forEach((name, idx) => {
                const condition = document.getElementById(`b-cond-${idx}`).value;
                const comment = document.getElementById(`b-memo-${idx}`).value.trim();

                if (state.batchType === 'normal') {
                    const timeVal = document.getElementById(`b-time-${idx}`).value.trim();
                    if (timeVal) {
                        let sec = parseTimeToSeconds(timeVal);
                        state.records.unshift({
                            id: 'rec_batch_' + Date.now() + '_' + idx,
                            date,
                            name,
                            type: 'normal',
                            menu,
                            distance: distanceInput,
                            timeSec: sec,
                            timeStr: formatSecondsToTimeStr(sec),
                            paceStr: calculatePace(distanceInput, sec),
                            condition,
                            comment
                        });
                        count++;
                    }
                } else {
                    const val = document.getElementById(`b-int-times-${idx}`).value.trim();
                    if (val) {
                        const parts = val.split(/\s+/);
                        let intervalTimes = [];
                        let intervalSecs = [];
                        let totalSec = 0;

                        parts.forEach(p => {
                            let s = parseTimeToSeconds(p);
                            if (s > 0) {
                                intervalSecs.push(s);
                                intervalTimes.push(formatSecondsToTimeStr(s));
                                totalSec += s;
                            }
                        });

                        const totalDist = distanceInput * intervalSecs.length;
                        state.records.unshift({
                            id: 'rec_batch_' + Date.now() + '_' + idx,
                            date,
                            name,
                            type: 'interval',
                            menu,
                            singleDist: distanceInput,
                            intervalTimes,
                            intervalSecs,
                            distance: totalDist,
                            timeSec: totalSec,
                            timeStr: formatSecondsToTimeStr(totalSec),
                            paceStr: calculatePace(totalDist, totalSec),
                            condition,
                            comment
                        });
                        count++;
                    }
                }
            });

            if (count === 0) {
                showToast('タイムが入力されたメンバーがいません。', 'error');
                return;
            }

            syncStorage();
            updateUI();
            showToast(`${count}名分の記録を一括登録しました！`, 'success');
            switchTab('records');
        }

